---
layout: base.njk
pagination:
  data: services
  size: 1
  alias: service
permalink: "/leistungen/{{ service.slug }}/"
eleventyComputed:
  title: "{{ service.teaserTitle }} in Düsseldorf | Dautibau"
  description: "{{ service.metaDescription }}"
---

<section class="page-hero">
  <div class="shell">
    <nav class="breadcrumb" aria-label="Brotkrumen">
      <a href="{{ '/' | url }}">Start</a>
      <span class="sep" aria-hidden="true">/</span>
      <a href="{{ '/leistungen/' | url }}">Leistungen</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="current">{{ service.teaserTitle }}</span>
    </nav>
    <p class="kicker">Leistung {{ service.num }}. Düsseldorf.</p>
    <h1>{{ service.title }}</h1>
    <p class="page-lead">{{ service.intro }}</p>
  </div>
</section>

<section class="section">
  <div class="shell">
    <div class="svc-detail">
      <div data-reveal>
        <p class="detail-intro">{{ service.intro }}</p>
        <div class="frame frame-tall" style="margin-top: 2.25rem; max-width: 26rem;">
          <span class="frame-caption">Projektfoto folgt</span>
        </div>
        <p class="provenance">Referenz: {{ service.teaserTitle }}. Raum Düsseldorf. Foto folgt.</p>
      </div>

      <div data-reveal data-reveal-delay="80">
        <p class="kicker" style="margin-bottom: 1.5rem;">Das steckt drin</p>
        <ul class="svc-points">
          {% for pt in service.points %}
          <li>
            <span class="pt-num">{{ loop.index | pad2 }}</span>
            <span class="pt-text">{{ pt }}</span>
          </li>
          {% endfor %}
        </ul>

        <p class="kicker" style="margin: 2.5rem 0 1rem;">Weitere Leistungen</p>
        <div class="svc-other">
          {% for s in services %}
          <a href="{{ ('/leistungen/' + s.slug + '/') | url }}"
             class="svc-chip{% if s.slug == service.slug %} is-current{% endif %}"
             {% if s.slug == service.slug %}aria-current="page"{% endif %}>
            {{ s.teaserTitle }}
          </a>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="shell">
    <div class="cta-inline" data-reveal>
      <h3>{{ service.title }} zum Festpreis. Kostenlos und unverbindlich.</h3>
      <div class="cta-inline-row">
        <a href="{{ site.phoneHref }}" class="btn btn-ink">Jetzt anrufen</a>
        <a href="{{ site.whatsapp }}" class="btn btn-ghost" rel="noopener">WhatsApp</a>
      </div>
    </div>
  </div>
</section>
