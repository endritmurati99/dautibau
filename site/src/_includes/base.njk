<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:locale" content="de_DE">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap">

  <link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%2317140F'/%3E%3Ctext x='16' y='23' font-family='Georgia,serif' font-size='20' fill='%23F4F1EA' text-anchor='middle'%3ED%3C/text%3E%3C/svg%3E">
  {% block head %}{% endblock %}
</head>
<body class="{{ bodyClass }}">
  <a href="#main" class="skip-link">Zum Inhalt springen</a>

  <header class="site-header" id="siteHeader" data-header>
    <div class="shell header-inner">
      <a href="{{ '/' | url }}" class="wordmark" aria-label="Dautibau Startseite">
        Dautibau<span class="wordmark-dot">.</span>
      </a>
      <nav class="primary-nav" aria-label="Hauptnavigation">
        <ul>
          {% for item in site.nav %}
          <li>
            <a href="{{ item.url | url }}"
               class="nav-link{% if item.url == '/' %}{% if page.url == '/' %} is-active{% endif %}{% elif page.url.startsWith(item.url) %} is-active{% endif %}"
               {% if item.url == '/' and page.url == '/' %}aria-current="page"{% elif item.url != '/' and page.url.startsWith(item.url) %}aria-current="page"{% endif %}>
              {{ item.title }}
            </a>
          </li>
          {% endfor %}
        </ul>
      </nav>
      <a href="{{ site.phoneHref }}" class="btn btn-primary header-cta">
        <span class="mono">Anrufen</span>
        <span aria-hidden="true" class="header-cta-num">{{ site.phoneDisplay }}</span>
      </a>
      <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="mobileNav" aria-label="Menü öffnen">
        <span></span><span></span><span></span>
      </button>
    </div>
    <nav class="mobile-nav" id="mobileNav" aria-label="Mobile Navigation" hidden>
      <ul>
        {% for item in site.nav %}
        <li><a href="{{ item.url | url }}" class="mobile-nav-link{% if item.url == '/' %}{% if page.url == '/' %} is-active{% endif %}{% elif page.url.startsWith(item.url) %} is-active{% endif %}">{{ item.title }}</a></li>
        {% endfor %}
        <li><a href="{{ '/kontakt/' | url }}" class="mobile-nav-link mobile-nav-cta">Kontakt aufnehmen</a></li>
      </ul>
    </nav>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="shell footer-grid">
      <div class="footer-brand">
        <a href="{{ '/' | url }}" class="wordmark wordmark-lg">Dautibau<span class="wordmark-dot">.</span></a>
        <p class="footer-tag">Trockenbau und Innenausbau in Düsseldorf. Ein Ansprechpartner vom Aufmaß bis zur Übergabe.</p>
        <p class="mono footer-catch">Gerade Wände sind kein Zufall.</p>
      </div>

      <div class="footer-col">
        <h2 class="footer-head mono">Leistungen</h2>
        <ul class="footer-list">
          {% for s in services %}
          <li><a href="{{ ('/leistungen/' + s.slug + '/') | url }}">{{ s.teaserTitle }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div class="footer-col">
        <h2 class="footer-head mono">Seiten</h2>
        <ul class="footer-list">
          <li><a href="{{ '/leistungen/' | url }}">Leistungen</a></li>
          <li><a href="{{ '/referenzen/' | url }}">Referenzen</a></li>
          <li><a href="{{ '/ueber-uns/' | url }}">Über uns</a></li>
          <li><a href="{{ '/kontakt/' | url }}">Kontakt</a></li>
          <li><a href="{{ '/impressum/' | url }}">Impressum</a></li>
          <li><a href="{{ '/datenschutz/' | url }}">Datenschutz</a></li>
        </ul>
      </div>

      <div class="footer-col footer-contact">
        <h2 class="footer-head mono">Kontakt</h2>
        <ul class="footer-list">
          <li><a href="{{ site.phoneHref }}" class="footer-phone">{{ site.phoneDisplay }}</a></li>
          <li><a href="{{ site.whatsapp }}" rel="noopener">WhatsApp schreiben</a></li>
          <li>{{ site.street }}</li>
          <li>{{ site.zip }} {{ site.city }}</li>
        </ul>
      </div>
    </div>
    <div class="shell footer-bottom">
      <p class="mono">© {% year %} Dautibau. Inhaber {{ site.owner }}.</p>
      <p class="mono footer-legal">
        <a href="{{ '/impressum/' | url }}">Impressum</a>
        <a href="{{ '/datenschutz/' | url }}">Datenschutz</a>
      </p>
    </div>
  </footer>

  <div class="mobile-bar" aria-label="Schnellkontakt">
    <a href="{{ site.phoneHref }}" class="mobile-bar-btn mobile-bar-call">
      <span class="mono">Jetzt anrufen</span>
    </a>
    <a href="{{ site.whatsapp }}" class="mobile-bar-btn mobile-bar-wa" rel="noopener">
      <span class="mono">WhatsApp</span>
    </a>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js" defer></script>
  <script src="{{ '/assets/main.js' | url }}" defer></script>
</body>
</html>
